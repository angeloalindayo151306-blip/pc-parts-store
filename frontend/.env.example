# Copy this file to .env only if you need to change the API address.
# Never put secrets in a VITE_ variable: everything starting with VITE_ is
# copied into the browser bundle and can be read by anyone.

# Local development: leave VITE_API_URL unset. The app then calls /api/v1 on
# its own address, and the Vite dev server forwards those calls to the backend.
#
# Deployed build: set it to the full API base URL, including /api/v1.
# VITE_API_URL=https://pc-parts-api-kik5.onrender.com/api/v1
