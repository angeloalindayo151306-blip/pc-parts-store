# Copy this file to .env and fill in the blank values. Never commit .env.
# Real keys, passwords and tokens must never be written in this file.

NODE_ENV=development
PORT=4000

# Postgres connection string
DATABASE_URL=

# Secret used to sign login tokens. Use a long random value.
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Browser origin allowed to call the API, and where Maya sends the customer back.
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Password for the seeded accounts (used by npm run seed)
SEED_PASSWORD=

# Payments: mock (local testing only, refused in production) or maya
PAYMENT_PROVIDER=mock
MAYA_BASE_URL=https://pg-sandbox.paymaya.com
MAYA_PUBLIC_KEY=
MAYA_SECRET_KEY=
# Secret in the webhook URL. The webhook is not registered with Maya.
MAYA_WEBHOOK_TOKEN=

# AI build recommendation. With GEMINI_API_KEY blank, the keyword fallback is used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_MS=20000
